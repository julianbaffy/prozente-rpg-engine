{
  "meta": {
    "titel": "Powergaming mit Prozenten",
    "version": "0.1-entwurf",
    "einheiten": { "schaden": "SP", "leben": "LP" },
    "regeln": {
      "stapeln": "Alle Modifikatoren, die auf dieselbe Schadensart wirken (Schadensartwort, Gruppenwort ELEMENTAR oder SCHADEN), werden addiert und als ein Faktor 1 + Summe angewendet.",
      "um_auf": "Modifikator mit 'prozent' = steigern/verringern UM p % (Faktor 1 + p/100). Modifikator mit 'auf' = steigern/verringern AUF a % (entspricht prozent = a - 100). Beides landet im selben Additionstopf.",
      "wert": "Ein Eintrag mit 'wert' ist ein fester Angriffswert (kein Würfel: min = mittel = max = wert). Bei Waffen steht er in der Tabelle als eine Zelle, bei allen anderen Gegenständen steht der absolute Schaden als Modifikator ('+ X QUELLE Schaden'; bei Spannen '+ min bis max QUELLE Schaden (Min · Mittel · Max)'). Ohne 'wert' gilt min / mittel / max (Würfel 1–2 = Min, 3–4 = Mittel, 5–6 = Max).",
      "reihenfolge": "1. Grundschaden aller Gegenstände summieren, 2. Umwandlung, 3. 'kein Schaden', 4. Modifikatoren pro Schadensart (addiert), 5. 'nachträglich' (Helm des Nachhalls, multipliziert), 6. Widerstände des Gegners, 7. Aufbau (Zins) pro Angriff.",
      "nachtraeglich": "Effekt { typ: 'nachtraeglich', prozent: x }: Nach den addierten Modifikatoren wird der fertige Schaden EINER frei wählbaren Schadensart noch einmal um x % gesteigert (Faktor 1 + x/100, multipliziert – NICHT zum Additionstopf gezählt). Im Build wählt man die Schadensart mit build.nachtraeglichAuf; ohne Angabe nimmt die Engine die Schadensart mit dem höchsten Mittelwert. Vorteil gegenüber einem gleich hohen addierten Bonus: G · m · x (m = Summe der addierten Modifikatoren dieser Schadensart). Stufe 9 = nicht im Pool der Einheiten 1–8."
    }
  },

  "quellen": ["FEUER", "EIS", "BLITZ", "PHYSISCH", "CHAOS"],
  "gruppen": {
    "ELEMENTAR": ["FEUER", "EIS", "BLITZ"],
    "SCHADEN": ["FEUER", "EIS", "BLITZ", "PHYSISCH", "CHAOS"]
  },

  "stufen": [
    { "nr": 1, "titel": "Die Schmiede", "pool": "Waffe + Zaubergegenstand",
      "lernziel": "Prozentwert berechnen (W = p · G); Modifikatoren derselben Schadensart addieren",
      "auftrag": "Rüste deine Figur so aus, dass sie maximalen Schaden anrichtet." },
    { "nr": 2, "titel": "Die Rüstkammer", "pool": "Waffe + Rüstung + Zaubergegenstand",
      "lernziel": "Wie Stufe 1; zusätzlich Umwandlung, Grundschaden-Boni und negative Modifikatoren",
      "auftrag": "Nutze auch die magische Rüstung für noch mehr Schaden." },
    { "nr": 3, "titel": "Die Monsterhöhlen", "pool": "zwei komplette Sets",
      "lernziel": "Prozentuale Verringerung/Erhöhung des erlittenen Schadens (Widerstand, Immunität, Anfälligkeit)",
      "auftrag": "Baue zwei Sets, mit denen du jedes Monster in höchstens 3 Kampfrunden besiegst (Pech / Durchschnitt / Glück)." },
    { "nr": 4, "titel": "Die Schriftrollenhändlerin", "pool": "Aussagen vergleichen",
      "lernziel": "Steigern/Verringern UM p % (1 ± p) versus AUF p % (Faktor p)",
      "auftrag": "Welche Schriftrollen bewirken dasselbe? Welche sind Fallen?" },
    { "nr": 5, "titel": "Der Verzauberer", "pool": "Prozentsatz bestimmen",
      "lernziel": "Prozentsatz p = W : G; Prozentsatz der Änderung (W : G − 1)",
      "auftrag": "Der Zauberer misst deinen Schaden und kennt den Grundschaden. Wie gut ist sein Zauber?" },
    { "nr": 6, "titel": "Die Trainingshalle", "pool": "Grundwert bestimmen",
      "lernziel": "Grundwert G = W : (1 ± p); typischer Fehler: W − p·W",
      "auftrag": "Wie stark ist die Übungswaffe wirklich? Lohnt es sich, sie mitzunehmen?" },
    { "nr": 7, "titel": "Duelle", "pool": "Ausrüstungssets vergleichen",
      "lernziel": "Absolut mehr versus prozentual mehr; Schwellenwert",
      "auftrag": "Ein Herausforderer bietet dir zwei Sets an. Rechne, wähle klug und tritt im Würfelduell an." },
    { "nr": 8, "titel": "Die Arena", "pool": "Waffen mit Aufbau",
      "lernziel": "Wiederholte prozentuale Steigerung (Zinseszins) 1,05^n; Vergleich bei verschieden viel Leben",
      "auftrag": "Welche Waffe besiegt Gegner mit wenig, welche Gegner mit viel Leben schneller?" }
  ],

